# Salin ke loadtest/.env. JANGAN commit .env.

# ---- Supabase LOKAL (lihat output `supabase status`) ----
SUPABASE_URL=http://127.0.0.1:54321
# Service role / secret key lokal. Dipakai untuk seed, login, dan menghapus data uji.
SUPABASE_SERVICE_ROLE_KEY=
# Skrip menolak URL non-lokal kecuali ini di-set 1 (skrip ini MENGHAPUS data).
LT_ALLOW_REMOTE=0

# ---- Akun dummy ----
# Jumlah akun = jumlah VU maksimum (stress 1000) agar tiap VU punya akun sendiri.
LT_USERS=1000
LT_PASSWORD=LoadTest#2026!
LT_CONCURRENCY=10

# ---- Target backend ----
# Dari host (untuk preflight health check)
LT_HOST_API_URL=http://localhost:4000/api/v1
# Dari dalam container k6
LT_K6_BASE_URL=http://host.docker.internal:4000/api/v1

# ---- Backend di Docker -> Supabase lokal (dipakai compose.backend-local.yml) ----
LT_BACKEND_SUPABASE_URL=http://host.docker.internal:54321

# ---- Observability ----
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jeda antar level (detik) agar sistem pulih
LT_COOLDOWN_SEC=60

# ---- Opsional: diteruskan ke k6 ----
# WARMUP=0
# WARMUP_VUS=10
# WARMUP_DURATION=2m
# SUBMIT_RATIO=0.3
# THINK_SCALE=1
# HOLD=30s          # uji coba singkat
# LOAD_VUS=20       # uji coba singkat
# STRESS_ABORT=1
# STRESS_ABORT_ERROR_RATE=0.5
