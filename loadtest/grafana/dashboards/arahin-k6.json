{
  "uid": "arahin-k6",
  "title": "ArahIn k6 Load Test",
  "description": "Hasil k6 (Prometheus remote write, native histogram). Fokus p95/p99, bukan rata-rata.",
  "tags": ["k6", "loadtest", "arahin"],
  "timezone": "Asia/Jakarta",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test ID",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
        "query": { "query": "label_values(k6_vus, testid)", "refId": "testid" },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "sort": 2,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "phase",
        "label": "Fase",
        "type": "custom",
        "query": "Beban utama : load, Warm-up : warmup, Semua : .+",
        "current": { "text": "Beban utama", "value": "load" },
        "options": [
          { "text": "Beban utama", "value": "load", "selected": true },
          { "text": "Warm-up", "value": "warmup", "selected": false },
          { "text": "Semua", "value": ".+", "selected": false }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rata-rata latensi",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "histogram_sum(sum(increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range]))) / histogram_count(sum(increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 latensi",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum(increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 latensi",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "histogram_quantile(0.99, sum(increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "(sum(increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\", expected_response=\"false\"}[$__range])) or vector(0)) / sum(increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__range]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total request",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__range]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "VU maksimum",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "max(max_over_time(k6_vus{testid=\"$testid\"}[$__range]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latensi: rata-rata vs p95 vs p99 (dengan jumlah VU)",
      "description": "Rata-rata menyembunyikan ekor distribusi. Bandingkan jarak garis p95/p99 terhadap rata-rata saat VU naik.",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0, "spanNulls": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rata-rata" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          {
            "matcher": { "id": "byName", "options": "VU" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "VU" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "rata-rata",
          "expr": "histogram_sum(sum(rate(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval]))) / histogram_count(sum(rate(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum(rate(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))"
        },
        {
          "refId": "D",
          "legendFormat": "VU",
          "expr": "sum(k6_vus{testid=\"$testid\"})"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput (request/detik) dan VU",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "VU" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "req/s", "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "VU", "expr": "sum(k6_vus{testid=\"$testid\"})" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "spanNulls": true, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "orange", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "error rate",
          "expr": "(sum(rate(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\", expected_response=\"false\"}[$__rate_interval])) or vector(0)) / sum(rate(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Status HTTP (request/detik)",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" }, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 latensi per endpoint",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 0, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{name}}", "expr": "histogram_quantile(0.95, sum by (name) (rate(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p99 latensi per endpoint",
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 0, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{name}}", "expr": "histogram_quantile(0.99, sum by (name) (rate(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Waktu tunggu server (TTFB) p95 vs waktu koneksi p95",
      "description": "TTFB tinggi = lambat di backend/DB. Connecting tinggi = antrean koneksi di load balancer/OS.",
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "waiting (TTFB) p95", "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_waiting_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))" },
        { "refId": "B", "legendFormat": "connecting p95", "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_connecting_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))" },
        { "refId": "C", "legendFormat": "blocked p95", "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_blocked_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Ringkasan per endpoint (rentang waktu dashboard)",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus-k6" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rata-rata" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 0 } ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 0 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 } ] } } ] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 0 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 } ] } } ] },
          { "matcher": { "id": "byName", "options": "request" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 } ] },
          { "matcher": { "id": "byName", "options": "error rate" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 2 } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "p95", "desc": true } ] },
      "targets": [
        { "refId": "A", "instant": true, "format": "table", "expr": "histogram_sum(sum by (name) (increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range]))) / histogram_count(sum by (name) (increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range])))" },
        { "refId": "B", "instant": true, "format": "table", "expr": "histogram_quantile(0.95, sum by (name) (increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range])))" },
        { "refId": "C", "instant": true, "format": "table", "expr": "histogram_quantile(0.99, sum by (name) (increase(k6_http_req_duration_seconds{testid=\"$testid\", phase=~\"$phase\"}[$__range])))" },
        { "refId": "D", "instant": true, "format": "table", "expr": "sum by (name) (increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__range]))" },
        { "refId": "E", "instant": true, "format": "table", "expr": "(sum by (name) (increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\", expected_response=\"false\"}[$__range])) or (0 * sum by (name) (increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__range])))) / sum by (name) (increase(k6_http_reqs_total{testid=\"$testid\", phase=~\"$phase\"}[$__range]))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "name": "endpoint", "Value #A": "rata-rata", "Value #B": "p95", "Value #C": "p99", "Value #D": "request", "Value #E": "error rate" }
          }
        }
      ]
    }
  ]
}
