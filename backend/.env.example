# Salin ke .env lalu isi. JANGAN commit .env.
PORT=4000

# Supabase: Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key mem-bypass RLS. Hanya untuk backend, jangan pernah dikirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Pembatas beban ke Supabase per instance (opsional). Kelebihan beban ditolak cepat
# dengan 503 alih-alih menumpuk di DB. Naikkan bila compute Supabase lebih besar.
# SUPABASE_MAX_SERENTAK=30
# SUPABASE_MAX_ANTRE=300
# SUPABASE_MAX_TUNGGU_MS=5000

# Origin frontend Next.js (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:3000

# Dataset responden (TIDAK dipakai rekomendasi; hanya untuk analisis data survei)
DATASET_SUMBER=sintetis

# Penjelasan rekomendasi (UC14):
#   mock      = penjelasan dari template komponen skor, tanpa API (default bila key kosong)
#   anthropic = Claude API dengan LLM_MODEL (default bila ANTHROPIC_API_KEY terisi)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
